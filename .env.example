# Web login password. This value is read directly by the server.
PASSWORD=change-this-password

# Runtime data inside the container.
KONOMI_DATA_PATH=/app/.data
KONOMI_USER_DATA=/app/.data

# Comma-separated container paths that Konomi is allowed to read images from.
# Match this with docker-compose.yml volume mount targets.
DOCKER_ALLOWED_ROOT_PATHS=/images

# Internal container port. The NAS-facing port is set in docker-compose.yml as 8091:3000.
PORT=3000
